# Only use the independently verified FinSim project. Never use Maghsaltak.
# These two values are public connection identifiers, not database credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side guard: must match the URL's project ref. No secrets required by the app.
SUPABASE_PROJECT_REF=
